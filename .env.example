# Environment Configuration for BLUECHAIN Ocean Prediction System
PROJECT_NAME="BLUECHAIN: AI-Powered Ocean Behaviour & Impact Prediction System"
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Use PostgreSQL with PostGIS in Docker or local Postgres:
# DATABASE_URL=postgresql://bluechain:bluechain_password@localhost:5432/bluechain_db
# In development without local Postgres, sqlite fallback with GeoJSON handles all operations seamlessly:
DATABASE_URL=sqlite:///./bluechain.db

# Data Ingestion Mode
USE_SAMPLE_DATA=true
SAMPLE_DATA_DIR=data/sample

# External API Keys (Optional - only required if USE_SAMPLE_DATA=false)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
ERDDAP_SERVER=https://coastwatch.pfeg.noaa.gov/erddap

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ML Models Directory
MODELS_DIR=ml/models
